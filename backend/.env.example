# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hilo?schema=public"

# Telegram
TELEGRAM_BOT_TOKEN="123456:ABC-DEF-your-bot-token-here"
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# JWT — generate real secrets with e.g. `openssl rand -hex 64`; never commit real values
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
