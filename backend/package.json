{
  "name": "hi-lo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Hi-Lo (Kef-Zk) — NestJS backend. Phases 1-7: DB schema, provably-fair game engine, wallet engine, auth, REST API layer, admin dashboard backend, and rate limiting / security headers / the abandoned-game sweep job.",
  "scripts": {
    "demo": "ts-node test/demo.ts",
    "demo:wallet": "ts-node test/wallet-demo.ts",
    "demo:auth": "ts-node test/auth-demo.ts",
    "demo:api": "ts-node test/game-api-demo.ts",
    "demo:admin": "ts-node test/admin-demo.ts",
    "demo:sweep": "ts-node test/sweep-demo.ts",
    "start": "nest start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "build": "npx prisma generate && nest build",
    "start:prod": "node dist/src/main.js",
    "start:dev": "nest start --watch"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^20.14.0",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
